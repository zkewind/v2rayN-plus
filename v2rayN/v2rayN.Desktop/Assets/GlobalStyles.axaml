<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!--  Add Controls for Previewer Here  -->
        </Border>
    </Design.PreviewWith>

    <Style Selector="DataGrid">
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultTertiaryForeground}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Theme" Value="{StaticResource LineTabControl}" />
    </Style>

    <Style Selector="TabControl.chrome-tabs">
        <Setter Property="Theme" Value="{StaticResource ChromeTabControlTheme}" />
        <Setter Property="Background" Value="{DynamicResource ChromeTabSelectedBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TabControl.chrome-tabs TabItem">
        <Setter Property="Background" Value="{DynamicResource ChromeTabBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChromeTabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12,12,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeTabForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="18,9" />
    </Style>

    <Style Selector="TabControl.chrome-tabs TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource ChromeTabHoverBackgroundBrush}" />
    </Style>

    <Style Selector="TabControl.chrome-tabs TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource ChromeTabSelectedBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Foreground" Value="{DynamicResource ChromeTabSelectedForegroundBrush}" />
        <Setter Property="Margin" Value="0,0,0,-1" />
        <Setter Property="Panel.ZIndex" Value="10" />
    </Style>

    <Style Selector="Button.IconButton">
        <Setter Property="Width" Value="{StaticResource IconButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource IconButtonHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource IconButtonWidth}" />
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
    </Style>

</Styles>
